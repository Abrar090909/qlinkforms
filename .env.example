# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the app (used for auth redirects). No trailing slash.
SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase > Connect > ORMs > Prisma
# Pooled connection (port 6543), used by the app at runtime.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432), used by Prisma migrations.
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional features. The app runs without them and says what is missing.

# Encrypts owners' Razorpay secrets at rest. Required to connect Razorpay.
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME value everywhere that shares a database (local, Vercel), or saved keys can't be read.
# PAYMENT_SECRETS_KEY=

# Receipt and owner-notification emails (resend.com > API Keys). Off when unset.
# RESEND_API_KEY=
# EMAIL_FROM="UPI Forms <receipts@yourdomain.in>"

# Protects /api/cron/reconcile. Vercel Cron sends it automatically when set.
# CRON_SECRET=

# Optional, for the signed-in e2e tests only (pnpm e2e). A confirmed test user:
# Supabase > Authentication > Users > Add user > Create new user, tick "Auto Confirm User".
# E2E_EMAIL=e2e@example.com
# E2E_PASSWORD=
